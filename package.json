{
  "name": "mon-view",
  "productName": "Mon View",
  "version": "1.0.0",
  "description": "Mon View - xem ảnh nhanh",
  "author": "Mondiro",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ag-psd": "^33.0.0",
    "electron-updater": "^6.8.11",
    "koffi": "^2.16.3",
    "utif": "^3.1.0"
  },
  "repository": "https://github.com/satthupc00/M-View",
  "build": {
    "appId": "com.mondiro.monview",
    "productName": "Mon View",
    "copyright": "Mondiro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!**/node_modules/koffi/src/**",
      "!**/node_modules/koffi/vendor/**",
      "!**/node_modules/koffi/doc/**",
      "!**/node_modules/ag-psd/{src,dist-es,clean.js}/**",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.ts"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MonView-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Mon View",
      "uninstallDisplayName": "Mon View",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "jfif",
          "gif",
          "webp",
          "ico",
          "bmp",
          "psd",
          "psb",
          "tga",
          "tif",
          "tiff"
        ],
        "name": "MonView.Image",
        "description": "Ảnh",
        "role": "Viewer"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "satthupc00",
        "repo": "M-View",
        "releaseType": "release"
      }
    ]
  }
}
