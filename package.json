{
  "name": "mon-view",
  "productName": "Mon View",
  "version": "1.0.3",
  "description": "Mon View - xem ảnh nhanh",
  "author": "Mondiro",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ag-psd": "^33.0.0",
    "electron-updater": "^6.8.11",
    "utif": "^3.1.0"
  },
  "repository": "https://github.com/satthupc00/M-View",
  "build": {
    "appId": "com.mondiro.monview",
    "productName": "Mon View",
    "copyright": "Mondiro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/ag-psd/{src,dist-es,clean.js}/**",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.ts"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MonView-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Mon View",
      "uninstallDisplayName": "Mon View",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": [
          "png"
        ],
        "name": "MonView.png",
        "description": "Ảnh PNG",
        "icon": "filetypes/png.ico",
        "role": "Viewer"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "jfif"
        ],
        "name": "MonView.jpg",
        "description": "Ảnh JPEG",
        "icon": "filetypes/jpg.ico",
        "role": "Viewer"
      },
      {
        "ext": [
          "gif"
        ],
        "name": "MonView.gif",
        "description": "Ảnh GIF",
        "icon": "filetypes/gif.ico",
        "role": "Viewer"
      },
      {
        "ext": [
          "webp"
        ],
        "name": "MonView.webp",
        "description": "Ảnh WebP",
        "icon": "filetypes/webp.ico",
        "role": "Viewer"
      },
      {
        "ext": [
          "ico"
        ],
        "name": "MonView.ico",
        "description": "Icon",
        "icon": "filetypes/ico.ico",
        "role": "Viewer"
      },
      {
        "ext": [
          "bmp"
        ],
        "name": "MonView.bmp",
        "description": "Ảnh BMP",
        "icon": "filetypes/bmp.ico",
        "role": "Viewer"
      },
      {
        "ext": [
          "psd"
        ],
        "name": "MonView.psd",
        "description": "Photoshop PSD",
        "icon": "filetypes/psd.ico",
        "role": "Viewer"
      },
      {
        "ext": [
          "psb"
        ],
        "name": "MonView.psb",
        "description": "Photoshop PSB",
        "icon": "filetypes/psb.ico",
        "role": "Viewer"
      },
      {
        "ext": [
          "tga"
        ],
        "name": "MonView.tga",
        "description": "Ảnh TGA",
        "icon": "filetypes/tga.ico",
        "role": "Viewer"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "name": "MonView.tif",
        "description": "Ảnh TIFF",
        "icon": "filetypes/tif.ico",
        "role": "Viewer"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "satthupc00",
        "repo": "M-View",
        "releaseType": "release"
      }
    ]
  }
}
